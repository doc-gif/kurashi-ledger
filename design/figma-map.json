            "Disabled"
          ],
          "note": "使ってよい組合せは combinationRule だけから決まる"
        },
        "Label": {
          "type": "TEXT",
          "figmaKey": "Label#8:0",
          "default": "総支給額"
        },
        "Hint": {
          "type": "TEXT",
          "figmaKey": "Hint#8:17",
          "default": "半角数字で入力（円単位。カンマは不要）"
        },
        "Show hint": {
          "type": "BOOLEAN",
          "figmaKey": "Show hint#8:34",
          "default": true
        },
        "Allow unknown": {
          "type": "BOOLEAN",
          "figmaKey": "Allow unknown#41:0",
          "default": true,
          "note": "false のとき「金額がわからない」を出さない（不明を認めない項目）。組合せは combinationRule"
        }
      },
      "combinationRule": {
        "$description": "design/components.md の「組合せの規則」と同じ規則。requires の各項目は「when が成り立つなら then も成り立つ」。どの項目にも当てはまらない組合せは制約なし",
        "properties": {
          "Value": [
            "Empty",
            "Amount",
            "Zero",
            "Unknown"
          ],
          "State": [
            "Default",
            "FocusInput",
            "FocusCheckbox",
            "Error",
            "Disabled"
          ],
          "Allow unknown": [
            true,
            false
          ]
        },
        "requires": [
          {
            "when": {
              "Value": "Unknown"
            },
            "then": {
              "Allow unknown": true
            }
          },
          {
            "when": {
              "State": "FocusInput"
            },
            "then": {
              "Value": {
                "not": "Unknown"
              }
            }
          },
          {
            "when": {
              "State": "Error"
            },
            "then": {
              "Value": {
                "not": "Unknown"
              }
            }
          },
          {
            "when": {
              "State": "FocusCheckbox"
            },
            "then": {
              "Allow unknown": true
            }
          }
        ],
        "figmaVariantsAre": {
          "Allow unknown": true
        }
      },
