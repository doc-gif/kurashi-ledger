  "ruleSets": [
    {
      "id": "jp-income-tax-salary-2025",
      "version": "1",
      "status": "draft",
      "approval": "未確認",
      "regime": "income-tax",
      "kind": "calculation",
      "title": "所得税（給与所得だけの居住者の年税額）令和7年分",
      "spec": "docs/rules/income-tax.md",
      "data": "rules/income-tax/jp-2025.json",
      "applies": [
        {
          "jurisdiction": {
            "kind": "national",
            "code": "JP"
          },
          "year": {
            "kind": "calendar",
            "year": 2025
          },
          "procedure": "year-end-adjustment",
          "referencePoint": {
            "kind": "date",
            "from": "2025-12-01"
          }
        },
        {
          "jurisdiction": {
            "kind": "national",
            "code": "JP"
          },
          "year": {
            "kind": "calendar",
            "year": 2025
          },
          "procedure": "tax-return",
          "referencePoint": {
            "kind": "date",
            "from": "2025-12-01"
          }
        }
      ],
      "sources": [
        "nta-2025kiso",
        "nta-nencho2025-tax",
        "nta-nencho2025-table",
        "nta-nencho2025-rates",
        "nta-ta-1410",
        "nta-ta-1411",
        "nta-ta-1199",
        "nta-ta-1180",
        "nta-ta-1191",
        "nta-ta-1195",
        "nta-ta-1177",
        "nta-ta-2260",
        "nta-shinkoku2025-taxable",
        "nta-shinkoku2025-reconstruction",
        "nta-shinkoku2025-balance",
        "egov-tsusoku",
        "nta-hotei2025-scope",
        "nta-hotei2025-payment"
      ],
      "requiredInputs": [
        {
          "path": "residency"
        },
        {
          "path": "incomeSources"
        },
        {
          "path": "taxpayerEvent.kind"
        },
        {
          "path": "returnKind",
          "procedures": [
            "tax-return"
          ]
        },
        {
          "path": "salaryRevenue"
        },
        {
          "path": "socialInsuranceDeduction"
        },
        {
          "path": "otherIncomeDeductions"
        },
        {
          "path": "incomeAdjustmentEligible"
        },
        {
          "path": "withheldTax"
        },
        {
          "path": "taxCredits"
        },
        {
          "path": "spouse",
          "nullable": true
        },
        {
          "path": "relatives",
          "emptyAllowed": true
        },
        {
          "path": "taxpayer.declaredAsSourceDeductionRelativeByOtherAndWithheld"
        }
      ],
      "unsupportedInputs": [
        {
          "path": "residency",
          "allowed": [
            "resident"
          ],
          "reason": "非居住者は範囲外"
        },
        {
          "path": "incomeSources",
          "allowed": [
            "salary-only"
          ],
          "reason": "給与所得以外の所得は範囲外"
        },
        {
          "path": "taxCredits",
          "allowed": [
            0
          ],
          "reason": "住宅借入金等特別控除等の税額控除は範囲外"
        },
        {
          "path": "taxpayerEvent.kind",
          "allowed": [
            "none"
          ],
          "reason": "年の中途の死亡・出国では、家族の判定の時点が死亡・出国の時になる（タックスアンサーNo.1180・1177）。この版は12月31日の現況だけを扱う"
        },
        {
          "path": "returnKind",
          "allowed": [
            "regular"
          ],
          "procedures": [
            "tax-return"
          ],
          "reason": "準確定申告（死亡・出国）は範囲外"
        },
        {
          "path": "spouse.livingAtYearEnd",
          "allowed": [
            true
          ],
          "reason": "年の中途で死亡した配偶者の判定の時点は確かめていない"
        },
        {
          "path": "relatives[].livingAtYearEnd",
          "allowed": [
            true
          ],
          "reason": "年の中途で死亡した親族の判定の時点は確かめていない"
        },
        {
          "path": "spouse.resident",
          "allowed": [
            true
          ],
          "reason": "非居住者である配偶者の要件は範囲外"
        },
        {
          "path": "relatives[].resident",
