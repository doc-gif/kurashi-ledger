        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169609766",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396221637"
      ]
    },
    {
      "id": "PR11-R102",
      "invariant_id": "INV-RECORDS",
      "cause_key": "ref-revision-semantics",
      "lesson": "参照ごとにcurrentと整数版のどちらを指すかを定め、過去時点の見方や固定した記録を未来の版へ結び付けない。関係の参照と確認済みの版を二重に固定して矛盾させない。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167319639",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5394711089",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5394786049",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5395565138"
      ]
    },
    {
      "id": "PR11-R103",
      "invariant_id": "INV-RECORDS",
      "cause_key": "pinned-snapshot-granularity",
      "lesson": "runに固定するスナップショットは、実行時の判定を一意に再現できる粒度で持つ。項目別の適用状態、年と支払者ごとに1つの採用、一意なキー、再確認に使う比較値と正規IDを含める。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168638670",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168995601",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170073901",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5394283625",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5395101941",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397837992"
      ]
    },
    {
      "id": "PR11-R104",
      "invariant_id": "INV-RECORDS",
      "cause_key": "annual-document-indivisible-scope",
      "lesson": "年間資料の値は範囲全体の不可分な総額として扱う。採用・比較・説明・runへの固定は資料の年と確定範囲に一致するときだけ許し、部分範囲や支払者ごとに重ねて加算しない。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167319878",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167392035",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168877085",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169528442",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169745593",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396221637"
      ]
    },
    {
      "id": "PR11-R105",
      "invariant_id": "INV-RECORDS",
      "cause_key": "self-referential-step-inputs",
      "lesson": "状態や上限の判定に、その判定の結果や対象自身を入力として含めない。段階ごとの入力集合を先に確定し、同じ計算を述べる各節で含める状態をそろえる。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170365823",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170623177",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396987055",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397221035"
      ]
    },
    {
      "id": "PR11-R106",
      "invariant_id": "INV-RECORDS",
      "cause_key": "contract-type-expressiveness",
      "lesson": "共通の型（集計値・coverage・不足状態・記録の種類）が、規則の求める全ケース（年間以外、採用未決定、採用元の混在、通知の重複、対応表の未定義、不完全な実績）を偽らずに表せるか確かめる。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167319780",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167319842",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167392077",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167699707",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5394879245",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5395101941",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396367197",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397343057"
      ]
    },
    {
      "id": "PR11-R107",
      "invariant_id": "INV-RECORDS",
      "cause_key": "free-value-identity-key",
      "lesson": "同一性・重複判定・集計に使うキーを自由な文字列や表示名にしない。型・名前空間・許す次元を定めた判別できるキーとし、集合の中での一意性か合算の規則を定める。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4167391984",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168877133",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169876181",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170141612",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5395101941",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396221637",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397135859"
      ]
    },
    {
      "id": "PR11-R108",
      "invariant_id": "INV-RECORDS",
      "cause_key": "restated-facts-drift",
      "lesson": "件数・列挙・ID・連番・前提のマスタを本文や合成例で手書きで繰り返すと正本とずれる。正本を参照し、合成例はfixtureとして契約の保存条件を満たすか確かめる。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170289483",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170471760",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397791070",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397837992",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397953279",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167530273"
      ]
    },
    {
      "id": "PR11-R109",
      "invariant_id": "INV-RECORDS",
      "cause_key": "lifecycle-transition-revalidation",
      "lesson": "保存時の検査を初回の保存だけに置かない。取消・取消解除・マスタの統合・復元・取込の全経路で同じ検査を行い、参照元と参照先への影響も確かめ直す。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168434467",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169446979",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169745539",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5396987055"
      ]
    },
    {
      "id": "PR11-R110",
      "invariant_id": "INV-RECORDS",
      "cause_key": "state-classification-precedence",
      "lesson": "状態の判定表は、条件が重なるときの優先順を明示する。異常終了・取り下げ・0件（空集合）・使えない関係などの境界でも結果が一意に決まるようにする。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168169997",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169609700",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5395437829",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#pullrequestreview-5397135859"
      ]
    },
    {
      "id": "PR11-R111",
      "invariant_id": "INV-RECORDS",
      "cause_key": "recorded-time-ordering",
      "lesson": "版の順序を時計の時刻に頼らない。時計の後退や同じ時刻でも一意に並ぶ記録順（連番など）を使い、生の時計値どうしの比較を保存条件にしない。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168108952",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168345106",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4168434527"
      ]
    },
    {
      "id": "PR11-R112",
      "invariant_id": "INV-REVIEW",
      "cause_key": "plan-assessment-drift",
      "lesson": "変更前の計画の確認方法と期待結果は、実際の差分と後から加えた方針に合わせて更新し、範囲外の変更や高リスクの新しい方針を評価から漏らさない。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4169609832",
        "https://github.com/doc-gif/kurashi-ledger/pull/11#discussion_r4170720974"
      ]
    },
    {
      "id": "PR10-R001",
      "invariant_id": "INV-RECORDS",
      "cause_key": "focus-target-per-element",
      "lesson": "フォーカスの表示と状態は値ではなくフォーカスできる要素ごとに定め、表示しない要素（不明を許さない項目のチェックボックス等）へのフォーカス状態を組合せから除く。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5393810516",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167245148",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167691997"
      ]
    },
    {
      "id": "PR10-R002",
      "invariant_id": "INV-RECORDS",
      "cause_key": "design-implementation-correspondence",
      "lesson": "Figma・トークン・CSS・外部の形式の対応は、実装で同じ表示を再現できる方式・寸法の定義・検証条件として一意に書き、「1対1」や標準への準拠などの主張は実物と照合する。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5393810516",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167245244",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167245294",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5394218551"
      ]
    },
    {
      "id": "PR10-R003",
      "invariant_id": "INV-RECORDS",
      "cause_key": "unknown-state-accessibility-semantics",
      "lesson": "不明の値とError・Disabled等の状態の組合せごとに、読み上げ・エラー文の関連付け・保存時のフォーカス先を定め、共通の規則と矛盾させないか、その組合せを無効にする。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5394143877",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167530172",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167923590"
      ]
    },
    {
      "id": "PR10-R004",
      "invariant_id": "INV-TASKS",
      "cause_key": "status-docs-current-state-coherence",
      "lesson": "同じ事実（成果物の作成状況・公開範囲・タスクへの割当・必須の記入欄）を書く状態資料・実装計画・台帳・ADR・テンプレートは、最終headでまとめて更新し、互いに照合する。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5394700750",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#discussion_r4167964285",
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5394370172",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394179233",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394323746",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394431368",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394614385",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5398208896"
      ]
    },
    {
      "id": "PR10-R101",
      "invariant_id": "INV-RECORDS",
      "cause_key": "ui-contract-state-mapping",
      "lesson": "UI部品の値の状態（空欄・金額・0・不明）は契約の金額の状態へ一意に対応付け、保存しない編集中の状態を決め、保存して再表示した状態が黙って変わらないようにする。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/10#pullrequestreview-5395958798"
      ]
    },
    {
      "id": "PR12-R001",
      "invariant_id": "INV-RELEASE",
      "cause_key": "setup-worktree-exclusion",
      "lesson": "依存の導入と導入記録の更新は、既存の記録の削除前から最終照合までを同じworktree単位の排他で囲み、2つ目を依存・記録の変更前に止める。排他の資源は削除される木の中に置かない。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5396006639",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4169111451"
      ]
    },
    {
      "id": "PR12-R002",
      "invariant_id": "INV-PRIVACY",
      "cause_key": "public-path-exception-scope",
      "lesson": "公開検査の場所の規則は、通常ファイル・symlink・gitlink・ディレクトリのすべてのindexの項目と大文字小文字の違いに同じく適用して.gitignoreと一致させ、例外は通常ファイルの最後の名前だけに限る。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5396182094",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167352689",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167508077",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4168174910",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4168993848",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4169251177",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394179233"
      ]
    },
    {
      "id": "PR12-R101",
      "invariant_id": "INV-RELEASE",
      "cause_key": "cleanup-failure-path-contract",
      "lesson": "成功したときだけ記録を残す契約を、fsync・unlink・印の書込み・解放の失敗やシグナルなど後始末の失敗経路でも保ち、失敗を握りつぶさず残った状態と終了コードを返す。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167352795",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4170913805",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4170947635",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4171009135"
      ]
    },
    {
      "id": "PR12-R102",
      "invariant_id": "INV-RELEASE",
      "cause_key": "install-record-verification-scope",
      "lesson": "導入記録の照合は、記録が保証すると述べる範囲（依存の宣言・lockfile・実行ファイルのリンクの解決先）をすべて確かめ、見抜けない直接操作などの限界は文書に正確に書く。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167508133",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167659740",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167780189",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4170947655",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4170947673",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5394684638"
      ]
    },
    {
      "id": "PR12-R103",
      "invariant_id": "INV-RELEASE",
      "cause_key": "verification-on-target-runtime",
      "lesson": "受入の検証は固定した版と対象OSで実行し、失敗・未実行を成功と扱わない。警告の抑止など継承した環境変数で検査が素通りしないようにする。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167352751",
        "https://github.com/doc-gif/kurashi-ledger/pull/12#pullrequestreview-5393999270"
      ]
    },
    {
      "id": "PR12-R104",
      "invariant_id": "INV-ROOT",
      "cause_key": "destructive-op-follows-link",
      "lesson": "削除・上書き・移動の前に、信頼した実体のルートから対象までの経路のすべての要素（深い祖先のディレクトリを含む）がsymlink・junctionでないこと、または解決した実体が許可した範囲の中にあることを確かめ、リンクを経て範囲外や別worktreeを変更しない。対象と直近の親だけの確認では、上位の祖先のリンクを見逃す。",
      "sources": [
        "https://github.com/doc-gif/kurashi-ledger/pull/12#discussion_r4167952957",
        "https://github.com/doc-gif/kurashi-ledger/pull/16#pullrequestreview-5398413357",
        "https://github.com/doc-gif/kurashi-ledger/pull/16#discussion_r4171162468"
      ]
    }
  ]
