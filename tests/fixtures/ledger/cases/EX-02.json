{
  "schemaVersion": 1,
  "contractVersion": "2.0",
  "caseId": "EX-02",
  "title": "分割入金と合算入金（過剰配分の拒否、使えない配分による保留、復元したデータの上限）",
  "consumers": ["T06", "T11"],
  "scenarios": [
    {
      "scenarioId": "EX-02-a",
      "title": "1件の明細を2つの口座に分けて入金",
      "covers": [{"doc": "examples.md", "section": "EX-02", "subsection": "(a)"}],
      "acceptance": ["order-independence", "no-double-income"],
      "rules": {"comparisonMapping": "none", "attribution": "none"},
      "operations": [
        {"op": "save", "opId": "o1", "at": "2026-11-26T01:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_201", "recordType": "payslip", "body": {
           "employerId": "emp_1",
           "paymentKind": {"state": "known", "value": "salary"},
           "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-10-21"}, "end": {"state": "known", "value": "2026-11-20"}}},
           "scheduledPayDate": {"state": "known", "value": "2026-11-25"},
           "grossPay": {"state": "known", "value": 230000},
           "bankTransferAmount": {"state": "known", "value": 182000}}}},
        {"op": "save", "opId": "o2", "at": "2026-11-26T01:01:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_201", "recordType": "bank-deposit", "body": {
           "accountId": "acct_1",
           "depositDate": {"state": "known", "value": "2026-11-25"},
           "amount": {"state": "known", "value": 150000}}}},
        {"op": "save", "opId": "o3", "at": "2026-11-26T01:02:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_202", "recordType": "bank-deposit", "body": {
           "accountId": "acct_2",
           "depositDate": {"state": "known", "value": "2026-11-25"},
           "amount": {"state": "known", "value": 32000}}}},
        {"op": "save", "opId": "o4", "at": "2026-11-26T01:03:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_201", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_201", "revision": "current", "line": "whole"},
           "to": {"id": "dep_201", "revision": "current", "line": "whole"},
           "amount": {"state": "known", "value": 150000},
           "confirmedAgainst": {"state": "known", "value": {"fromRevision": 1, "toRevision": 1}},
           "proposedBy": "user"}}},
        {"op": "save", "opId": "o5", "at": "2026-11-26T01:04:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_202", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_201", "revision": "current", "line": "whole"},
           "to": {"id": "dep_202", "revision": "current", "line": "whole"},
           "amount": {"state": "known", "value": 32000},
           "confirmedAgainst": {"state": "known", "value": {"fromRevision": 1, "toRevision": 1}},
           "proposedBy": "user"}}}
      ],
      "orderVariants": [["o2", "o3", "o1", "o5", "o4"], ["o3", "o1", "o5", "o2", "o4"]],
      "checks": [
        {"checkId": "c01", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_1"], "from": "2026-11-01", "to": "2026-11-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 150000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "口座1の入金はdep_201の150,000だけ。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "銀行入金amount"}]},
        {"checkId": "c02", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-11-01", "to": "2026-11-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 32000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "口座2の入金はdep_202の32,000だけ。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "銀行入金amount"}]},
        {"checkId": "c03", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": [], "from": "2026-11-01", "to": "2026-11-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 182000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "accountIdsが空の範囲は口座を限定しない。150,000 ＋ 32,000 ＝ 182,000。",
         "cites": [{"doc": "common-types.md", "section": "11", "quote": "許す次元が空の並びなら「限定しない」"}]},
        {"checkId": "c04", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "grossPay"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-11-01", "to": "2026-11-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 230000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "明細は1件なので支給額は230,000。入金が2件あっても支給が2回あったとみなさない。",
         "cites": [{"doc": "examples.md", "section": "EX-02", "quote": "入金が2件あるので支給が2回あったとみなさない"}]},
        {"checkId": "c05", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "pay_201"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "182,000 −（150,000 ＋ 32,000）＝ 0。多対多を許し、1件の明細を複数の入金に分けてよい。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "1件の明細を複数の入金に分けてよい（分割入金）"}]},
        {"checkId": "c06", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "dep_201"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "150,000 − 150,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "入金ごとの「未照合の額」＝入金額"}]},
        {"checkId": "c07", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "dep_202"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "32,000 − 32,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "入金ごとの「未照合の額」＝入金額"}]}
      ]
    },
