{
  "schemaVersion": 1,
  "contractVersion": "2.0",
  "caseId": "EX-03",
  "title": "同じ日・同じ金額の別件（再送、二重登録、取消と取消の取り消し、雇用先の二重登録、分類だけの訂正、取込のキー）",
  "consumers": ["T06", "T09", "T11"],
  "scenarios": [
    {
      "scenarioId": "EX-03-a",
      "title": "同額別件・再送・二重登録の取消と取消の取り消し",
      "covers": [{"doc": "examples.md", "section": "EX-03"}],
      "acceptance": ["same-amount-different", "correction"],
      "rules": {"comparisonMapping": "none", "attribution": "none"},
      "operations": [
        {"op": "save", "opId": "o1", "at": "2026-10-31T01:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_301", "recordType": "bank-deposit", "writeRequestId": "w-301", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-10-30"}, "amount": {"state": "known", "value": 30000},
           "descriptionText": {"state": "known", "value": "フリコミ ビーシヤ（架空）"}, "purpose": {"state": "known", "value": "pay"}}}},
        {"op": "save", "opId": "o2", "at": "2026-10-31T01:00:05.000Z", "expect": {"outcome": "replayed", "of": "o1"},
         "record": {"id": "dep_301", "recordType": "bank-deposit", "writeRequestId": "w-301", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-10-30"}, "amount": {"state": "known", "value": 30000},
           "descriptionText": {"state": "known", "value": "フリコミ ビーシヤ（架空）"}, "purpose": {"state": "known", "value": "pay"}}}},
        {"op": "save", "opId": "o3", "at": "2026-10-31T01:01:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_302", "recordType": "bank-deposit", "writeRequestId": "w-302", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-10-30"}, "amount": {"state": "known", "value": 30000},
           "descriptionText": {"state": "known", "value": "フリコミ ビーシヤ（架空）"}, "purpose": {"state": "known", "value": "reimbursement"}}}},
        {"op": "save", "opId": "o4", "at": "2026-10-31T01:01:30.000Z", "expect": {"outcome": "rejected", "reason": "write-request-conflict"},
         "record": {"id": "dep_390", "recordType": "bank-deposit", "writeRequestId": "w-302", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-10-30"}, "amount": {"state": "known", "value": 31000}}}},
        {"op": "save", "opId": "o5", "at": "2026-10-31T01:02:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dcs_301", "recordType": "decision", "body": {
           "decisionType": "duplicate-review",
           "targets": [{"id": "dep_301", "revision": "current", "line": "whole"}, {"id": "dep_302", "revision": "current", "line": "whole"}],
           "value": "distinct", "reasonNote": "給与と経費の精算の別の振込（勤務先に確認）"}}},
        {"op": "save", "opId": "o6", "at": "2026-10-31T01:03:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_301", "recordType": "payslip", "body": {
           "employerId": "emp_2", "paymentKind": {"state": "known", "value": "salary"},
           "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-09-01"}, "end": {"state": "known", "value": "2026-09-30"}}},
           "scheduledPayDate": {"state": "known", "value": "2026-10-30"},
           "grossPay": {"state": "known", "value": 33000}, "incomeTax": {"state": "known", "value": 3000},
           "bankTransferAmount": {"state": "known", "value": 30000}}}},
        {"op": "save", "opId": "o7", "at": "2026-10-31T01:04:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_301", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_301", "revision": "current", "line": "whole"},
           "to": {"id": "dep_301", "revision": "current", "line": "whole"},
           "amount": {"state": "known", "value": 30000},
           "confirmedAgainst": {"state": "known", "value": {"fromRevision": 1, "toRevision": 1}}, "proposedBy": "user"}}},
        {"op": "save", "opId": "o8", "at": "2026-11-05T01:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_303", "recordType": "bank-deposit", "writeRequestId": "w-303", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-10-30"}, "amount": {"state": "known", "value": 30000}}}},
        {"op": "save", "opId": "o9", "at": "2026-11-05T01:01:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dcs_302", "recordType": "decision", "body": {
           "decisionType": "duplicate-review",
           "targets": [{"id": "dep_301", "revision": "current", "line": "whole"}, {"id": "dep_303", "revision": "current", "line": "whole"}],
           "value": "same", "reasonNote": "同じ入金を2回入力した"}}},
        {"op": "save", "opId": "o10", "at": "2026-11-05T01:02:00.000Z", "expect": {"outcome": "rejected", "reason": "body-change-on-void-or-unvoid"},
         "record": {"id": "dep_303", "recordType": "bank-deposit", "revision": 2, "reason": "void",
           "duplicateOf": {"state": "known", "value": {"id": "dep_301", "revision": "current", "line": "whole"}},
           "body": {"amount": {"state": "known", "value": 29000}}}},
        {"op": "save", "opId": "o11", "at": "2026-11-05T01:03:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_303", "recordType": "bank-deposit", "revision": 2, "reason": "void",
           "duplicateOf": {"state": "known", "value": {"id": "dep_301", "revision": "current", "line": "whole"}}}},
        {"op": "save", "opId": "o12", "at": "2026-11-20T01:00:00.000Z", "expect": {"outcome": "rejected", "reason": "transition-not-allowed"},
         "record": {"id": "dep_303", "recordType": "bank-deposit", "revision": 3, "reason": "correct-input-error",
           "body": {"amount": {"state": "known", "value": 29000}}}},
        {"op": "save", "opId": "o13", "at": "2026-11-20T01:01:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_303", "recordType": "bank-deposit", "revision": 3, "reason": "unvoid",
           "changeNote": {"state": "known", "value": "実は別の3件目の振込（経費の精算）だった"}}},
        {"op": "save", "opId": "o14", "at": "2026-11-20T01:02:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dcs_302", "recordType": "decision", "revision": 2, "reason": "new-information",
           "knownOn": {"state": "known", "value": "2026-11-20"},
           "body": {"value": "distinct", "reasonNote": "別の3件目の振込（経費の精算）だった"}}}
      ],
      "checks": [
        {"checkId": "c01", "afterOp": "o2",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 30000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "同じwriteRequestIdの再送は、新しい記録を作らず最初の結果を返す。記録はdep_301の1件だけ。",
         "cites": [{"doc": "common-types.md", "section": "10", "quote": "新しい記録・改訂を作らず、最初の結果を返す"},
                   {"doc": "examples.md", "section": "EX-03", "quote": "記録はdep_301の1件だけ"}]},
        {"checkId": "c02", "afterOp": "o4",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": [["dep_301", "dep_302"]]},
         "reason": "別の操作（w-302）なので、口座・日付・金額が同じでも別の記録として保存する。口座・入金日・金額がすべて一致するので重複の候補として表示する（保存は止めない）。同じw-302で内容が違う要求は拒否され、記録は作られない。",
         "cites": [{"doc": "common-types.md", "section": "10", "quote": "同じ内容でも、別の操作なら別の記録として保存できる"},
                   {"doc": "common-types.md", "section": "10", "quote": "同じwriteRequestIdで内容が違う要求が来た場合は、誤りとして拒否する"},
                   {"doc": "reconciliation.md", "section": "7", "quote": "銀行入金は口座・入金日・金額"}]},
        {"checkId": "c03", "afterOp": "o5",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": []},
         "reason": "distinctの判断がある組は、両方の記録を残し、候補に出さない。",
         "cites": [{"doc": "reconciliation.md", "section": "7", "quote": "両方の記録を残し、その組を候補に出さない"}]},
        {"checkId": "c04", "afterOp": "o7",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 60000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "同額別件の2件はどちらも入金なので両方を数える（30,000 ＋ 30,000）。",
         "cites": [{"doc": "examples.md", "section": "EX-03", "quote": "complete 60,000"}]},
        {"checkId": "c05", "afterOp": "o7",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "grossPay"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_2"], "accountIds": [], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 33000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "支給額はpay_301だけ。経費の精算の入金dep_302を給与の集計に入れない。",
         "cites": [{"doc": "records.md", "section": "5", "quote": "payでも給与の集計には入らない"},
                   {"doc": "examples.md", "section": "EX-03", "quote": "dep_302を給与の集計に入れない"}]},
        {"checkId": "c06", "afterOp": "o7",
         "query": {"kind": "unreconciled", "record": "dep_302"},
         "expect": {"amount": {"state": "known", "value": 30000}},
         "reason": "経費の精算は給与ではないので未照合のまま残ってよい。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "給与以外の入金（経費の精算等）が未照合で残ってよい"}]},
        {"checkId": "c07", "afterOp": "o7",
         "query": {"kind": "unreconciled", "record": "dep_301"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "30,000 − 有効なalc_301の30,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "入金ごとの「未照合の額」＝入金額"}]},
        {"checkId": "c08", "afterOp": "o8",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 90000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "二重登録のdep_303も、取り消すまでは有効な入金として数える。口座・日付・金額が同じことだけで保存を拒否したり自動で統合したりしない。",
         "cites": [{"doc": "examples.md", "section": "EX-03", "quote": "口座・日付・金額が同じことだけで、保存を拒否したり自動で統合したりしない"}]},
        {"checkId": "c09", "afterOp": "o8",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": [["dep_301", "dep_303"], ["dep_302", "dep_303"]]},
         "reason": "dep_303は、dep_301・dep_302のどちらとも口座・入金日・金額が一致する。dep_301とdep_302の組はdistinctの判断で抑制される。",
         "cites": [{"doc": "examples.md", "section": "EX-03", "quote": "重複の候補2組（dep_301とdep_303、dep_302とdep_303）"}]},
        {"checkId": "c10", "afterOp": "o11",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 60000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "取消した記録は集計から除く（履歴には残す）。取消の改訂でbodyを変える保存（金額29,000）は拒否され、bodyを変えない取消だけが保存される。",
         "cites": [{"doc": "common-types.md", "section": "9", "quote": "取消した記録（最新の改訂がvoided）は、集計・照合・重複候補から除く"},
                   {"doc": "common-types.md", "section": "9", "quote": "は直前の改訂と同じ値にし、違えば保存を拒否する"}]},
        {"checkId": "c11", "afterOp": "o11",
         "query": {"kind": "decisionPremise", "decision": "dcs_302"},
         "expect": {"premise": "holds"},
         "reason": "sameの判断は、2件が二重登録の取消をたどって同じ正規の記録に着く間だけ前提を満たす。dep_303のduplicateOfがdep_301を指すので有効のまま。",
         "cites": [{"doc": "reconciliation.md", "section": "4", "quote": "2件が、二重登録の取消（duplicateOf）をたどって同じ取消していない記録（正規の記録）に着く間だけ前提を満たす"}]},
        {"checkId": "c12", "afterOp": "o11",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": []},
         "reason": "重複の候補は有効な記録だけを比べる。取消したdep_303は候補から除かれ、dep_301とdep_302はdistinctで抑制される。",
         "cites": [{"doc": "reconciliation.md", "section": "7", "quote": "同じ種類の有効な記録"}]},
        {"checkId": "c13", "afterOp": "o13",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_2"], "from": "2026-10-01", "to": "2026-10-31"}},
         "expect": {"values": [{"state": "complete", "knownSum": 90000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "取消した記録に続けられる改訂はunvoidだけ（correct-input-errorは拒否）。取消を取り消すとdep_303は有効に戻り、90,000。",
         "cites": [{"doc": "common-types.md", "section": "9", "quote": "取消した記録に続けられる改訂はunvoidだけ"},
                   {"doc": "examples.md", "section": "EX-03", "quote": "dep_303は有効に戻り、入金額（口座2、2026-10）はcomplete 90,000"}]},
        {"checkId": "c14", "afterOp": "o13",
         "query": {"kind": "decisionPremise", "decision": "dcs_302"},
         "expect": {"premise": "broken"},
         "reason": "両方が有効になったので、sameの前提（同じ正規の記録に着く）が崩れ、要確認になる。",
         "cites": [{"doc": "reconciliation.md", "section": "4", "quote": "両方が有効になった（取消の取り消し等）、または残す側が取消・差し替えされたら要確認"}]},
        {"checkId": "c15", "afterOp": "o13",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": [["dep_301", "dep_303"], ["dep_302", "dep_303"]]},
         "reason": "候補を抑制するのは前提を満たすdistinctの判断だけ。sameの判断は候補を抑制しないので、両方が有効に戻ったdep_301とdep_303の組は再び候補に出る（distinctに改訂すると出なくなる）。",
         "cites": [{"doc": "reconciliation.md", "section": "7", "quote": "duplicate-reviewの判断がdistinct（同額別件）: 両方の記録を残し、その組を候補に出さない"},
                   {"doc": "examples.md", "section": "EX-03", "quote": "利用者がdcs_302をdistinctに改訂（new-information）すると、dep_301とdep_303の組は候補に出なくなる"}]},
        {"checkId": "c16", "afterOp": "end",
         "query": {"kind": "duplicateCandidates", "recordType": "bank-deposit"},
         "expect": {"pairs": [["dep_302", "dep_303"]]},
         "reason": "dcs_302をdistinctに改訂したので、dep_301とdep_303の組は出なくなる。dep_302とdep_303の組は判断するまで候補に残る。",
         "cites": [{"doc": "examples.md", "section": "EX-03", "quote": "dep_302とdep_303の組は、判断するまで重複の候補として残る"}]},
        {"checkId": "c17", "afterOp": "end",
         "query": {"kind": "decisionPremise", "decision": "dcs_302"},
         "expect": {"premise": "holds"},
         "reason": "判断を改訂すると、その改訂の時点の値が新しい前提になる。",
         "cites": [{"doc": "reconciliation.md", "section": "4", "quote": "判断の改訂で前提を新しくする"}]}
      ]
    },
    {
      "scenarioId": "EX-03-b",
      "title": "雇用先の二重登録（マスタの取消と正規のID、取消の取り消しによる要再確認）",
      "covers": [{"doc": "examples.md", "section": "EX-03"}],
      "rules": {"comparisonMapping": "none", "attribution": "none"},
      "operations": [
        {"op": "save", "opId": "o1", "at": "2026-12-01T01:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "emp_9", "recordType": "employer", "body": {"displayName": "勤務先B（重複）"}}},
        {"op": "save", "opId": "o2", "at": "2026-12-01T01:01:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_301", "recordType": "payslip", "body": {
           "employerId": "emp_2", "paymentKind": {"state": "known", "value": "salary"},
           "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-09-01"}, "end": {"state": "known", "value": "2026-09-30"}}},
           "scheduledPayDate": {"state": "known", "value": "2026-10-30"},
           "grossPay": {"state": "known", "value": 33000}, "bankTransferAmount": {"state": "known", "value": 30000}}}},
        {"op": "save", "opId": "o3", "at": "2026-12-01T01:02:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_304", "recordType": "payslip", "body": {
           "employerId": "emp_9", "paymentKind": {"state": "known", "value": "salary"},
           "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-10-01"}, "end": {"state": "known", "value": "2026-10-31"}}},
           "scheduledPayDate": {"state": "known", "value": "2026-11-30"},
           "grossPay": {"state": "known", "value": 33000}, "bankTransferAmount": {"state": "known", "value": 30000}}}},
        {"op": "save", "opId": "o4", "at": "2026-12-01T01:03:00.000Z", "expect": {"outcome": "rejected", "reason": "master-void-referenced"},
         "record": {"id": "emp_9", "recordType": "employer", "revision": 2, "reason": "void"}},
        {"op": "save", "opId": "o5", "at": "2026-12-01T01:04:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "emp_9", "recordType": "employer", "revision": 2, "reason": "void",
           "duplicateOf": {"state": "known", "value": {"id": "emp_2", "revision": "current", "line": "whole"}}}},
        {"op": "save", "opId": "o6", "at": "2026-12-01T01:05:00.000Z", "expect": {"outcome": "rejected", "reason": "master-void-referenced"},
         "record": {"id": "emp_2", "recordType": "employer", "revision": 2, "reason": "void"}},
        {"op": "save", "opId": "o7", "at": "2026-12-01T01:06:00.000Z", "expect": {"outcome": "rejected", "reason": "ref-target-invalid"},
         "record": {"id": "emp_2", "recordType": "employer", "revision": 2, "reason": "void",
           "duplicateOf": {"state": "known", "value": {"id": "emp_9", "revision": "current", "line": "whole"}}}},
        {"op": "save", "opId": "o8", "at": "2026-12-01T01:07:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_305", "recordType": "payslip", "body": {
           "employerId": "emp_9", "paymentKind": {"state": "known", "value": "salary"},
           "scheduledPayDate": {"state": "known", "value": "2026-12-31"},
           "grossPay": {"state": "known", "value": 33000}}}},
        {"op": "save", "opId": "o9", "at": "2026-12-01T01:08:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_304", "recordType": "bank-deposit", "body": {
           "accountId": "acct_2", "depositDate": {"state": "known", "value": "2026-11-30"}, "amount": {"state": "known", "value": 30000},
           "payerHint": {"state": "known", "value": "emp_2"}}}},
        {"op": "save", "opId": "o10", "at": "2026-12-01T01:09:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_304", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_304", "revision": "current", "line": "whole"},
