{
  "schemaVersion": 1,
  "contractVersion": "1.0",
  "caseId": "EX-01",
  "title": "銀行入金だけを記録し、後から明細を追加する",
  "consumers": ["T06", "T09", "T11"],
  "scenarios": [
    {
      "scenarioId": "EX-01-a",
      "title": "入金だけを記録し、あとで明細と証憑を追加して照合する（入金を先に入力）",
      "covers": [
        {"doc": "examples.md", "section": "EX-01", "subsection": "手順1:"},
        {"doc": "examples.md", "section": "EX-01", "subsection": "手順2:"}
      ],
      "acceptance": ["bank-only", "no-double-income", "order-independence"],
      "rules": {"comparisonMapping": "none", "attribution": "none"},
      "operations": [
        {"op": "save", "opId": "o1", "at": "2026-09-25T12:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_101", "recordType": "bank-deposit",
           "knownOn": {"state": "known", "value": "2026-09-25"},
           "body": {
             "accountId": "acct_1",
             "depositDate": {"state": "known", "value": "2026-09-25"},
             "amount": {"state": "known", "value": 182000},
             "descriptionText": {"state": "known", "value": "キュウヨ エーシヤ（架空）"},
             "payerHint": {"state": "known", "value": "emp_1"},
             "purpose": {"state": "known", "value": "pay"}}}},
        {"op": "save", "opId": "o2", "at": "2026-10-01T10:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_101", "recordType": "payslip",
           "knownOn": {"state": "known", "value": "2026-09-24"},
           "body": {
             "employerId": "emp_1",
             "paymentKind": {"state": "known", "value": "salary"},
             "periodLabel": {"state": "known", "value": "9月分"},
             "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-08-21"}, "end": {"state": "known", "value": "2026-09-20"}}},
             "scheduledPayDate": {"state": "known", "value": "2026-09-25"},
             "grossPay": {"state": "known", "value": 230000},
             "taxablePay": {"state": "known", "value": 220000},
             "nonTaxablePay": {"state": "known", "value": 10000},
             "commutingAllowance": {"state": "known", "value": 10000},
             "commutingAllowanceTaxTreatment": {"state": "known", "value": "non-taxable"},
             "otherEarnings": {"state": "known", "value": []},
             "incomeTax": {"state": "known", "value": 4000},
             "residentTax": {"state": "known", "value": 10000},
             "healthInsurance": {"state": "known", "value": 11500},
             "nursingCareInsurance": {"state": "not-applicable", "note": "架空の設定で対象外"},
             "pensionInsurance": {"state": "known", "value": 21000},
             "employmentInsurance": {"state": "known", "value": 1500},
             "otherDeductions": {"state": "known", "value": []},
             "yearEndAdjustment": {"state": "not-applicable"},
             "totalDeductions": {"state": "known", "value": 48000},
             "netPay": {"state": "known", "value": 182000},
             "bankTransferAmount": {"state": "known", "value": 182000},
             "supersedes": {"state": "not-applicable"}}}},
        {"op": "save", "opId": "o3", "at": "2026-10-01T10:05:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_101", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_101", "revision": "current", "line": "whole"},
           "to": {"id": "dep_101", "revision": "current", "line": "whole"},
           "amount": {"state": "known", "value": 182000},
           "confirmedAgainst": {"state": "known", "value": {"fromRevision": 1, "toRevision": 1}},
           "proposedBy": "user"}}},
        {"op": "saveEvidenceFile", "opId": "o4", "at": "2026-10-01T10:06:00.000Z", "expect": {"outcome": "accepted"},
         "file": {"id": "evf_101", "sha256": "1111111111111111111111111111111111111111111111111111111111111111", "byteSize": 2048,
           "mediaType": "application/pdf", "originalFileName": "合成の明細.pdf",
           "storageName": "1111111111111111111111111111111111111111111111111111111111111111.pdf", "importedAt": "2026-10-01T10:06:00.000Z"}},
        {"op": "save", "opId": "o5", "at": "2026-10-01T10:07:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "evl_101", "recordType": "evidence-link", "body": {
           "evidenceFileId": "evf_101",
           "target": {"id": "pay_101", "revision": "current", "line": "whole"},
           "locator": {"state": "not-applicable", "note": "ファイル全体"},
           "role": "source"}}}
      ],
      "orderVariants": [["o2", "o1", "o3", "o4", "o5"], ["o1", "o2", "o4", "o5", "o3"]],
      "checks": [
        {"checkId": "c01", "afterOp": "o1",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_1"], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 182000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "入金額の採用元は銀行入金のamountだけ。対象の記録はdep_101の1件で値があり、不足がないのでcomplete。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "銀行入金amount"},
                   {"doc": "common-types.md", "section": "11", "quote": "missingがなく、対象の記録が1件以上あり、knownの項目が1件以上ある"}]},
        {"checkId": "c02", "afterOp": "o1",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "grossPay"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "no-records", "knownSum": 0, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "支給額の採用元は給与明細のgrossPayだけで、銀行入金を足さない。明細がないので記録なし（no-records）で、入金額182,000にも0円にもしない。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "支給額（入力済みの明細）"},
                   {"doc": "common-types.md", "section": "11", "quote": "「記録なし」。0円と表示しない"},
                   {"doc": "examples.md", "section": "EX-01", "quote": "手順1で、支給額を182,000（入金額）にしない"}]},
        {"checkId": "c03", "afterOp": "o1",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "incomeTax"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "no-records", "knownSum": 0, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "源泉徴収税額は明細の該当項目だけから集計する。入金だけの記録では、源泉徴収税額は分からないまま（記録なし）で、0円と表示しない。",
         "cites": [{"doc": "records.md", "section": "5", "quote": "勤務先の支給額・源泉徴収税額・社会保険料は分からないままにする"},
                   {"doc": "examples.md", "section": "EX-01", "quote": "源泉徴収税額を0円と表示しない"}]},
        {"checkId": "c04", "afterOp": "o1",
         "query": {"kind": "unreconciled", "record": "dep_101"},
         "expect": {"amount": {"state": "known", "value": 182000}},
         "reason": "未照合の額＝入金額 −（有効な確定済みのtransfer-to-depositの合計）。配分がないので入金額のまま。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "入金ごとの「未照合の額」＝入金額"}]},
        {"checkId": "c05", "afterOp": "o1",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-by-income-year", "item": "grossPay"}, "axis": "income-year",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": 2026, "to": 2026}},
         "expect": {"values": [{"state": "no-records", "knownSum": 0, "missing": []}]},
         "reason": "所得の年の明細の合計の採用元は帰属の年が決まった給与明細。明細がなく、帰属未判定の一覧も空なので記録なし。入金は所得の年の集計に入らない。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "所得の年ごとの明細の合計"},
                   {"doc": "reconciliation.md", "section": "8", "quote": "一覧が空でなければ、年Y・範囲Sの所得の年の集計はincompleteにする"}]},
        {"checkId": "c06", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_1"], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 182000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "明細と照合配分を足しても入金額は変わらない。照合配分は金額を移さない。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "照合配分は金額を移さない"},
                   {"doc": "examples.md", "section": "EX-01", "quote": "182,000（手順1から変わらない）"}]},
        {"checkId": "c07", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "grossPay"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 230000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "支給額はpay_101のgrossPay 230,000だけ。入金額182,000を足して412,000にしない（明細の追加で収入は二重にならない）。",
         "cites": [{"doc": "reconciliation.md", "section": "10", "quote": "照合配分は金額を移さない。明細と入金を結んでも、どちらの集計も増えない"},
                   {"doc": "examples.md", "section": "EX-01", "quote": "収入を 182,000 ＋ 230,000 ＝ 412,000 にしない"}]},
        {"checkId": "c08", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "incomeTax"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 4000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "源泉徴収税額は明細の記載どおりの4,000。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "源泉徴収税額・住民税・各保険料（明細）"}]},
        {"checkId": "c09", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "dep_101"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "182,000 − 有効な確定済みのalc_101の182,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "その入金をtoとする確定済みのtransfer-to-depositのうち、使われ方が有効（9）のものの合計"}]},
        {"checkId": "c10", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "pay_101"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "未照合の振込額＝bankTransferAmount 182,000 − 有効な確定済みの配分182,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "明細ごとの「未照合の振込額」＝bankTransferAmount"}]},
        {"checkId": "c11", "afterOp": "end",
         "query": {"kind": "allocationUsage", "allocation": "alc_101"},
         "expect": {"usage": "valid"},
         "reason": "確定の条件（入金の側182,000 ≤ 182,000、明細の側182,000 ≤ 182,000、payerHintとemployerIdが一致）を満たし、参照先は有効で版も変わっていないので、使われ方の表のどれにも当たらず有効。",
         "cites": [{"doc": "reconciliation.md", "section": "9", "quote": "段階3で残った候補（上のどれにも当たらない）"},
                   {"doc": "reconciliation.md", "section": "3", "quote": "payerHintがknownなら一致すること"}]},
        {"checkId": "c12", "afterOp": "end",
         "query": {"kind": "attribution", "payslip": "pay_101"},
         "expect": {"state": "undetermined", "year": {"state": "unknown"}, "candidateYears": [{"from": 2026, "to": 2026}]},
         "reason": "年間資料も利用者の指定もなく、T14の規則も承認前なので根拠がない（undetermined）。候補の年は、支払予定日2026、勤務期間2026-08-21〜09-20（2026）、行の並びは確かめて空、結んだ入金dep_101の入金日2026で、2026だけ。",
         "cites": [{"doc": "reconciliation.md", "section": "8", "quote": "根拠が1つもない（空の集合）"},
                   {"doc": "reconciliation.md", "section": "8", "quote": "確定済みのtransfer-to-deposit（9で除かれていないもの）で結んだ入金のdepositDateの年"}]},
        {"checkId": "c13", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-by-income-year", "item": "grossPay"}, "axis": "income-year",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": 2026, "to": 2026}},
         "expect": {"values": [{"state": "incomplete", "knownSum": 0, "missing": [
           {"ref": {"id": "pay_101", "revision": 1, "line": "whole"}, "field": {"kind": "derived", "key": "income-year"}, "state": "undetermined"}]}]},
         "reason": "帰属が決まった明細はないのでknownSumは0。pay_101は帰属未判定で候補の年に2026を含むので、2026の集計に不足として挙がり、incompleteになる（規則の承認前に年の合計をcompleteに見せない）。",
         "cites": [{"doc": "reconciliation.md", "section": "8", "quote": "規則の承認前に、あとで帰属しうる年の集計をcompleteに見せないため"}]}
      ]
    },
    {
      "scenarioId": "EX-01-b",
      "title": "明細を先に入力し、あとで入金を入力して照合する",
      "covers": [{"doc": "examples.md", "section": "EX-01", "subsection": "手順2:"}],
      "acceptance": ["order-independence", "no-double-income"],
      "rules": {"comparisonMapping": "none", "attribution": "none"},
      "operations": [
        {"op": "save", "opId": "o1", "at": "2026-10-01T10:00:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "pay_101", "recordType": "payslip",
           "knownOn": {"state": "known", "value": "2026-09-24"},
           "body": {
             "employerId": "emp_1",
             "paymentKind": {"state": "known", "value": "salary"},
             "periodLabel": {"state": "known", "value": "9月分"},
             "workPeriod": {"state": "known", "value": {"start": {"state": "known", "value": "2026-08-21"}, "end": {"state": "known", "value": "2026-09-20"}}},
             "scheduledPayDate": {"state": "known", "value": "2026-09-25"},
             "grossPay": {"state": "known", "value": 230000},
             "incomeTax": {"state": "known", "value": 4000},
             "netPay": {"state": "known", "value": 182000},
             "bankTransferAmount": {"state": "known", "value": 182000}}}},
        {"op": "save", "opId": "o2", "at": "2026-10-01T10:02:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "dep_101", "recordType": "bank-deposit",
           "knownOn": {"state": "known", "value": "2026-09-25"},
           "body": {
             "accountId": "acct_1",
             "depositDate": {"state": "known", "value": "2026-09-25"},
             "amount": {"state": "known", "value": 182000},
             "payerHint": {"state": "known", "value": "emp_1"},
             "purpose": {"state": "known", "value": "pay"}}}},
        {"op": "save", "opId": "o3", "at": "2026-10-01T10:05:00.000Z", "expect": {"outcome": "accepted"},
         "record": {"id": "alc_101", "recordType": "allocation", "body": {
           "kind": "transfer-to-deposit", "allocationStatus": "confirmed",
           "from": {"id": "pay_101", "revision": "current", "line": "whole"},
           "to": {"id": "dep_101", "revision": "current", "line": "whole"},
           "amount": {"state": "known", "value": 182000},
           "confirmedAgainst": {"state": "known", "value": {"fromRevision": 1, "toRevision": 1}},
           "proposedBy": "user"}}}
      ],
      "checks": [
        {"checkId": "c01", "afterOp": "o1",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_1"], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "no-records", "knownSum": 0, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "明細だけの間は、入金額の採用元（銀行入金）がないので記録なし。明細の振込額を入金額に足さない。",
         "cites": [{"doc": "examples.md", "section": "EX-01", "quote": "明細だけの間は、入金額がno-records"}]},
        {"checkId": "c02", "afterOp": "o1",
         "query": {"kind": "unreconciled", "record": "pay_101"},
         "expect": {"amount": {"state": "known", "value": 182000}},
         "reason": "明細だけの間は、未照合の振込額はbankTransferAmountのまま。",
         "cites": [{"doc": "examples.md", "section": "EX-01", "quote": "pay_101の未照合の振込額が182,000"}]},
        {"checkId": "c03", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "deposit-amount"}, "axis": "deposit-date",
           "scope": {"employerIds": [], "accountIds": ["acct_1"], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 182000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "入力の順序が違っても、照合配分の確定のあとの集計はEX-01-aと同じ。",
         "cites": [{"doc": "examples.md", "section": "EX-01", "quote": "明細を先に、入金を後に入力しても、alc_101を確定したあとの集計は同じ"},
                   {"doc": "common-types.md", "section": "11", "quote": "集計と照合の結果は、記録の入力順・保存順に依存しない"}]},
        {"checkId": "c04", "afterOp": "end",
         "query": {"kind": "aggregate", "key": {"kind": "payslip-item", "item": "grossPay"}, "axis": "scheduled-pay-date",
           "scope": {"employerIds": ["emp_1"], "accountIds": [], "from": "2026-09-01", "to": "2026-09-30"}},
         "expect": {"values": [{"state": "complete", "knownSum": 230000, "coverage": {"state": "not-applicable"}, "missing": []}]},
         "reason": "支給額はpay_101のgrossPayだけで、入金額を足さない。",
         "cites": [{"doc": "reconciliation.md", "section": "2", "quote": "給与明細grossPay"}]},
        {"checkId": "c05", "afterOp": "end",
         "query": {"kind": "unreconciled", "record": "dep_101"},
         "expect": {"amount": {"state": "known", "value": 0}},
         "reason": "182,000 − 有効な確定済みの配分182,000 ＝ 0。",
         "cites": [{"doc": "reconciliation.md", "section": "3", "quote": "入金ごとの「未照合の額」＝入金額"}]}
      ]
    }
  ]
}
