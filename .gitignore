# 公開範囲の規則と例外の点検手順は docs/public-data.md。.gitignoreは追加の防御で、
# 主な境界は「実データのデータルートをrepoの外に置く」こと（ADR-0006）。
# 例外を変えるときは scripts/lib/public-policy.ts と試験の見本も同じPRで直す。
node_modules/
# npm run setupの作業中の印（ADR-0008）。commitすると、ほかのcloneのsetupが止まる。
/.kurashi-ledger-setup.lock
dist/
coverage/
.idea/
*.iml
.DS_Store
Thumbs.db
# 実データになりうる名前は、大文字小文字を区別せずに除外する（Linuxでも同じになるよう、
# [pP][dD][fF] のように書く。公開検査も同じく大文字小文字を区別しない）。
.[eE][nN][vV]
.[eE][nN][vV].*
!.[eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]
# 例外は通常のファイルだけ。.env.exampleという名前のディレクトリは、どの階層でも除外し直す
# （末尾の / はディレクトリだけに当たる。あとに書いた行が優先される）。
.[eE][nN][vV].[eE][xX][aA][mM][pP][lL][eE]/
# 実データ・出力・バックアップ用のディレクトリはリポジトリ直下だけを除外する
# （src/domain/evidence/ のようなソースの置き場所を除外しないため）。
/[dD][aA][tT][aA]/
/[pP][rR][iI][vV][aA][tT][eE]/
/[lL][oO][cC][aA][lL]-[dD][aA][tT][aA]/
/[eE][vV][iI][dD][eE][nN][cC][eE]/
/[eE][xX][pP][oO][rR][tT][sS]/
/[bB][aA][cC][kK][uU][pP][sS]/
# 実データになりうるが、ソース・文書・設定に要らない形式（scripts/lib/public-policy.tsと同じ一覧）。
# json・md・svg・ts・txt・xml等は、ソースと文書に要るので除外しない（docs/public-data.md）。
# 文書
*.[pP][dD][fF]
*.[dD][oO][cC]
*.[dD][oO][cC][xX]
*.[oO][dD][tT]
*.[rR][tT][fF]
*.[pP][aA][gG][eE][sS]
# 画像
*.[pP][nN][gG]
*.[jJ][pP][gG]
*.[jJ][pP][eE][gG]
*.[jJ][fF][iI][fF]
*.[hH][eE][iI][cC]
*.[hH][eE][iI][fF]
*.[wW][eE][bB][pP]
*.[gG][iI][fF]
*.[tT][iI][fF]
*.[tT][iI][fF][fF]
*.[bB][mM][pP]
*.[aA][vV][iI][fF]
*.[dD][nN][gG]
# 表計算・表形式
*.[cC][sS][vV]
*.[tT][sS][vV]
*.[xX][lL][sS][xX]
*.[xX][lL][sS]
*.[xX][lL][sS][mM]
*.[xX][lL][sS][bB]
*.[oO][dD][sS]
*.[nN][uU][mM][bB][eE][rR][sS]
# 金融機関の明細の書き出し
*.[oO][fF][xX]
*.[qQ][fF][xX]
*.[qQ][iI][fF]
*.[qQ][bB][oO]
# メールの書き出し
*.[eE][mM][lL]
*.[mM][sS][gG]
*.[mM][bB][oO][xX]
# アーカイブ・圧縮
*.[zZ][iI][pP]
*.7[zZ]
*.[rR][aA][rR]
*.[tT][aA][rR]
*.[gG][zZ]
*.[tT][gG][zZ]
*.[bB][zZ]2
*.[xX][zZ]
*.[zZ][sS][tT]
# ログ
*.[lL][oO][gG]
# 鍵・証明書
*.[pP][eE][mM]
*.[kK][eE][yY]
*.[pP]12
*.[pP][fF][xX]
# 暗号化したバックアップ
*.[aA][gG][eE]
# DB（付随するファイルを含む）
*.[sS][qQ][lL][iI][tT][eE]*
*.[dD][bB]
*.[dD][bB]-*
.venv/
__pycache__/
# 例外: 合成データのfixture（tests/fixtures/）とデザイン資産（design/）だけ。
# 場所の名前は小文字だけ（大文字小文字を区別する）。拡張子は区別しない。
!/tests/fixtures/**/*.[cC][sS][vV]
!/tests/fixtures/**/*.[pP][dD][fF]
!/tests/fixtures/**/*.[pP][nN][gG]
!/tests/fixtures/**/*.[jJ][pP][gG]
!/tests/fixtures/**/*.[jJ][pP][eE][gG]
!/design/**/*.[pP][nN][gG]
!/design/**/*.[jJ][pP][gG]
!/design/**/*.[jJ][pP][eE][gG]
# 例外は通常のファイルだけ。拡張子のような名前のディレクトリは、例外の場所の中でも除外する
# （末尾の / はディレクトリだけに当たる。あとに書いた行が優先される）。
/tests/fixtures/**/*.[cC][sS][vV]/
/tests/fixtures/**/*.[pP][dD][fF]/
/tests/fixtures/**/*.[pP][nN][gG]/
/tests/fixtures/**/*.[jJ][pP][gG]/
/tests/fixtures/**/*.[jJ][pP][eE][gG]/
/design/**/*.[pP][nN][gG]/
/design/**/*.[jJ][pP][gG]/
/design/**/*.[jJ][pP][eE][gG]/
